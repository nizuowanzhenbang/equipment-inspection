APP_MODE=production
# Generate a fresh secret before starting; an empty value intentionally fails validation.
SECRET_KEY=
DATABASE_URL=sqlite:///./equipment_inspection.db
DEBUG=false
SCHEDULER_ENABLED=false
ALLOWED_ORIGINS=["http://localhost:5175"]
# Set your public browser origin when deploying behind TLS.
# Empty signature secret reuses SECRET_KEY. Supply a separate random secret if required.
SIGNATURE_SECRET=
SAFETY_SYSTEM_URL=
PROCUREMENT_SYSTEM_URL=
